# Copy this file to .env and replace the placeholder with a Gemini API key.
# Docker Compose injects the value when the worker container starts; the key is
# intentionally excluded from both Git and the Docker image.
GOOGLE_API_KEY=replace-me

# Google model used by the ADK release approval agent. Verify the model is
# available to your key with:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"
# Older models such as gemini-2.5-flash are closed to new API keys and fail the
# session turn with a 404.
ADK_MODEL=gemini-3.6-flash
