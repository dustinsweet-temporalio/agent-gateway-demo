FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install the Temporal CLI, which bundles the local dev server and Web UI.
RUN curl -sSf https://temporal.download/cli.sh | sh \
    && cp /root/.temporalio/bin/temporal /usr/local/bin/temporal \
    && temporal --version

RUN mkdir -p /data

EXPOSE 7233 8233

# start-dev is for development only. --db-filename persists state to the volume so
# the demo survives container restarts. The Web UI is served on 8233.
#
# Two namespaces, not one. "default" is Agent Gateway's; "release-safety" belongs
# to the Release Safety team, who own canary analysis. Namespace separation is
# the honest boundary for "a different team runs this": independent retention,
# independent visibility, independent operator ownership, independent failure
# domain. It also gives the Web UI a namespace selector the demo can switch
# between, which makes two systems look like two systems. Creating a namespace on
# start-dev is free, so there is no reason to model this as anything weaker.
CMD ["temporal", "server", "start-dev", \
     "--ip", "0.0.0.0", \
     "--db-filename", "/data/temporal.db", \
     "--namespace", "release-safety", \
     "--ui-port", "8233"]
